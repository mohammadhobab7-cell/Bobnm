pragma solidity ^0.8.20;

// Interface for interacting with ERC-20 tokens
interface IERC20 {
    function transferFrom(address sender, address recipient, uint256 amount) external returns (bool);
    function transfer(address recipient, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

contract SimpleUniswap {
    // State variables for the two tokens in the liquidity pool
    IERC20 public tokenA;
    IERC20 public tokenB;

    // Reserves to track the balance of each token in the pool
    uint256 public reserveA;
    uint256 public reserveB;

    // Initialize the contract with the addresses of Token A and Token B
    constructor(address _tokenA, address _tokenB) {
        tokenA = IERC20(_tokenA);
        tokenB = IERC20(_tokenB);
    }

    // 1. Function to add liquidity to the pool
    function addLiquidity(uint256 _amountA, uint256 _amountB) external {
        // Transfer tokens from user's wallet to this contract
        tokenA.transferFrom(msg.sender, address(this), _amountA);
        tokenB.transferFrom(msg.sender, address(this), _amountB);

        // Update the contract reserves
        reserveA = tokenA.balanceOf(address(this));
        reserveB = tokenB.balanceOf(address(this));
    }

    // Internal function to calculate output amount based on Automated Market Maker (AMM) formula: X * Y = K
    function getAmountOut(uint256 inputAmount, uint256 inputReserve, uint256 outputReserve) public pure returns (uint256) {
        require(inputReserve > 0 && outputReserve > 0, "Invalid reserves");
        
        // Uniswap formula with 0% fees for simplicity: (dx * y) / (x + dx)
        uint256 numerator = inputAmount * outputReserve;
        uint256 denominator = inputReserve + inputAmount;
        return numerator / denominator;
    }

    // 2. Swap Function: Trade Token A to receive Token B
    function swapAforB(uint256 _amountAIn) external {
        require(_amountAIn > 0, "Amount must be greater than 0");

        // Calculate how much Token B the user should receive
        uint256 amountBOut = getAmountOut(_amountAIn, reserveA, reserveB);

        // Perform the token swap
        tokenA.transferFrom(msg.sender, address(this), _amountAIn);
        tokenB.transfer(msg.sender, amountBOut);

        // Sync the updated reserves
        reserveA = tokenA.balanceOf(address(this));
        reserveB = tokenB.balanceOf(address(this));
    }

    // 3. Swap Function: Trade Token B to receive Token A
    function swapBforA(uint256 _amountBIn) external {
        require(_amountBIn > 0, "Amount must be greater than 0");

        // Calculate how much Token A the user should receive
        uint256 amountAOut = getAmountOut(_amountBIn, reserveB, reserveA);

        // Perform the token swap
        tokenB.transferFrom(msg.sender, address(this), _amountBIn);
        tokenA.transfer(msg.sender, amountAOut);

        // Sync the updated reserves
        reserveA = tokenA.balanceOf(address(this));
        reserveB = tokenB.balanceOf(address(this));
    }
}
